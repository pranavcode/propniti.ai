    "expect": { "isInvoice": true, "vendor": "QuickFix", "invoiceNumber": "QF-5102", "total": 347.35, "lineItems": 3, "checksOk": ["Document is an invoice", "Vendor and invoice number", "Line items add up", "US dollars"] }
  },
  {
    "id": "extract-euro-currency",
