# All optional. With no keys the app runs on mock data.
# If a key is set but the call fails, the app falls back to mock data and says so.

# AI_PROVIDER=anthropic   # anthropic | openai | mock (default: whichever key is set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
